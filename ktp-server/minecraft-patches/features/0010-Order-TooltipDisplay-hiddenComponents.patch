From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bjarne Koll <git@lynxplay.dev>
Date: Sun, 22 Mar 2026 16:14:14 +0000
Subject: [PATCH] Order TooltipDisplay hiddenComponents

The usage of ReferenceLinkedOpenHashSet is rather questionable as it
maintains a specific iteration order while completely ignoring it for
comparison purposes.
As such, it breaks any form of consistent serialisation of itemstacks as
the encoder cache considers two ReferenceLinkedOpenHashSet instances
with different iteration orders equal even if they would not produce an
equal nbt output.

Replace it with the RegistrySinkSortedSet, which uses the registry id of
each data component to enforce order.

diff --git a/net/minecraft/world/item/component/TooltipDisplay.java b/net/minecraft/world/item/component/TooltipDisplay.java
index 4fd251c5836ab81234f76e6ce681247d9ea39003..1a5fbafc51c328e4f584c6611eaafff02c1c638e 100644
--- a/net/minecraft/world/item/component/TooltipDisplay.java
+++ b/net/minecraft/world/item/component/TooltipDisplay.java
@@ -14,7 +14,7 @@ import net.minecraft.network.codec.StreamCodec;
 public record TooltipDisplay(boolean hideTooltip, SequencedSet<DataComponentType<?>> hiddenComponents) {
     private static final Codec<SequencedSet<DataComponentType<?>>> COMPONENT_SET_CODEC = DataComponentType.CODEC
         .listOf()
-        .xmap(ReferenceLinkedOpenHashSet::new, List::copyOf);
+        .xmap(dev.lynxplay.ktp.item.component.DataComponentSequencedSet::new, List::copyOf); // KTP - order tooltip display hiddenComponents
     public static final Codec<TooltipDisplay> CODEC = RecordCodecBuilder.create(
         i -> i.group(
                 Codec.BOOL.optionalFieldOf("hide_tooltip", false).forGetter(TooltipDisplay::hideTooltip),
@@ -36,7 +36,7 @@ public record TooltipDisplay(boolean hideTooltip, SequencedSet<DataComponentType
             return this;
         }
 
-        SequencedSet<DataComponentType<?>> newHiddenComponents = new ReferenceLinkedOpenHashSet<>(this.hiddenComponents);
+        SequencedSet<DataComponentType<?>> newHiddenComponents = new dev.lynxplay.ktp.item.component.DataComponentSequencedSet(this.hiddenComponents); // KTP - order tooltip display hiddenComponents
         if (hidden) {
             newHiddenComponents.add(component);
         } else {
