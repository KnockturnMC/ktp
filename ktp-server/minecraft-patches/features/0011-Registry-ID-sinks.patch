From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bjarne Koll <git@lynxplay.dev>
Date: Sun, 22 Mar 2026 15:22:10 +0000
Subject: [PATCH] Registry ID sinks

Add registry id sinks which may be implemented by objects stored in
minecrafts registries in order for them to access their network integer
ids.
The main usage for this is map and set implementations for these
types, which can be based on BitSet and Object arrays respectively.

diff --git a/net/minecraft/core/MappedRegistry.java b/net/minecraft/core/MappedRegistry.java
index ad1558693564ebd18f5e16b85ae552d2af95efef..b5ac3c9ec54c1390f67542900980cd85331ea412 100644
--- a/net/minecraft/core/MappedRegistry.java
+++ b/net/minecraft/core/MappedRegistry.java
@@ -135,6 +135,7 @@ public class MappedRegistry<T> implements WritableRegistry<T> {
             this.registryLifecycle = this.registryLifecycle.add(registrationInfo.lifecycle());
             this.temporaryUnfrozenMap.put(key.identifier(), value); // Paper - support pre-filling in registry mod API
             this.injectFluidRegister(key, value); // Paper - fluid method optimisations
+            if (value instanceof final dev.lynxplay.ktp.core.RegistryIDSink sink) sink.idSinkState().bind(this.key(), size); // KTP - registry id sinks
             return reference;
         }
     }
diff --git a/net/minecraft/core/component/DataComponentType.java b/net/minecraft/core/component/DataComponentType.java
index 3016f983496eac78eb074ae74577b8a6bdc80b29..accaf2c71bbc830a3d3a4e682a1f61eb40349837 100644
--- a/net/minecraft/core/component/DataComponentType.java
+++ b/net/minecraft/core/component/DataComponentType.java
@@ -4,7 +4,7 @@ import com.mojang.serialization.Codec;
 import com.mojang.serialization.DataResult;
 import java.util.Map;
 import java.util.Objects;
-import net.minecraft.core.Registry;
+
 import net.minecraft.core.registries.BuiltInRegistries;
 import net.minecraft.core.registries.Registries;
 import net.minecraft.network.RegistryFriendlyByteBuf;
@@ -13,7 +13,7 @@ import net.minecraft.network.codec.StreamCodec;
 import net.minecraft.util.Util;
 import org.jspecify.annotations.Nullable;
 
-public interface DataComponentType<T> {
+public interface DataComponentType<T> extends dev.lynxplay.ktp.core.RegistryIDSink { // KTP - registry id sinks
     Codec<DataComponentType<?>> CODEC = Codec.lazyInitialized(() -> BuiltInRegistries.DATA_COMPONENT_TYPE.byNameCodec());
     StreamCodec<RegistryFriendlyByteBuf, DataComponentType<?>> STREAM_CODEC = StreamCodec.recursive(
         streamCodec -> ByteBufCodecs.registry(Registries.DATA_COMPONENT_TYPE)
@@ -83,6 +83,12 @@ public interface DataComponentType<T> {
         }
 
         static class SimpleType<T> implements DataComponentType<T> {
+            // KTP start - registry id sinks
+            private final dev.lynxplay.ktp.core.RegistryIDSinkState idSinkState = new dev.lynxplay.ktp.core.RegistryIDSinkState();
+            public dev.lynxplay.ktp.core.RegistryIDSinkState idSinkState() {
+                return idSinkState;
+            }
+            // KTP end - registry id sinks
             private final @Nullable Codec<T> codec;
             private final StreamCodec<? super RegistryFriendlyByteBuf, T> streamCodec;
             private final boolean ignoreSwapAnimation;
