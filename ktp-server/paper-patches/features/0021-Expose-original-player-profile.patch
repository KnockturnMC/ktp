From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bjarne Koll <git@lynxplay.dev>
Date: Thu, 26 Feb 2026 10:26:48 +0000
Subject: [PATCH] Expose original player profile

When changing a player profile after the player connected, certain
plugins might be interested in their original, mojang authenticated,
usernames.
Expose the original player profile for this usecase.

diff --git a/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java b/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
index 39d4243f0abb15c0d6a9603ef3c62f3a82882d5a..62fdfcbd9c38ed82aa5915dab9b23fce2dc88aea 100644
--- a/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
+++ b/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
@@ -3462,4 +3462,13 @@ public class CraftPlayer extends CraftHumanEntity implements Player, PluginMessa
             : net.kyori.adventure.util.TriState.NOT_SET;
     }
     // KTP end - glow override
+    // KTP start - expose original game profile
+    /**
+     * {@return the player profile this player originally logged in with.}
+     */
+    @Override
+    public com.destroystokyo.paper.profile.PlayerProfile getOriginalPlayerProfile() {
+        return com.destroystokyo.paper.profile.CraftPlayerProfile.asBukkitCopy(this.getHandle().originalGameProfile);
+    }
+    // KTP end - expose original game profile
 }
