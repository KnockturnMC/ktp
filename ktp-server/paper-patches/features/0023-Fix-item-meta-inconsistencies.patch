From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bjarne Koll <git@lynxplay.dev>
Date: Sun, 22 Mar 2026 03:12:38 +0000
Subject: [PATCH] Fix item meta inconsistencies

The order of the set of data components hidden via the
HIDE_ADDITIONAL_TOOLTIP is not consistent in paper as it uses a plain
set over items with non defined hashcodes.

As the mojang implementation of the TooltipDisplay makes use of a
LinkedSet for storing the data components, this leads to non consistent
set order for tooltip displays across different JVMs.

diff --git a/src/main/java/org/bukkit/craftbukkit/inventory/CraftMetaItem.java b/src/main/java/org/bukkit/craftbukkit/inventory/CraftMetaItem.java
index 405d9367e3959c715d73505fd85fac3602e26116..68a020fc4637646e04c164379515994912fd6fd1 100644
--- a/src/main/java/org/bukkit/craftbukkit/inventory/CraftMetaItem.java
+++ b/src/main/java/org/bukkit/craftbukkit/inventory/CraftMetaItem.java
@@ -315,7 +315,7 @@ public class CraftMetaItem implements ItemMeta, Damageable, Repairable, BlockDat
     private List<net.minecraft.advancements.predicates.BlockPredicate> canBreakPredicates;
 
     // hide_additional_tooltip backward compatibility based on TooltipDisplayComponentFix#CONVERTED_ADDITIONAL_TOOLTIP_TYPES
-    private static final Set<DataComponentType<?>> HIDDEN_COMPONENTS_PREVIOUSLY = Set.of(
+    private static final Set<DataComponentType<?>> HIDDEN_COMPONENTS_PREVIOUSLY = new ReferenceLinkedOpenHashSet<>(List.of( // KTP - consistent order of hide additional tooltip entries
         DataComponents.BANNER_PATTERNS,
         DataComponents.BEES,
         DataComponents.BLOCK_ENTITY_DATA,
@@ -334,7 +334,7 @@ public class CraftMetaItem implements ItemMeta, Damageable, Repairable, BlockDat
         DataComponents.POTION_CONTENTS,
         DataComponents.TROPICAL_FISH_PATTERN,
         DataComponents.WRITTEN_BOOK_CONTENT
-    );
+    )); // KTP - consistent order of hide additional tooltip entries
 
     private static final Map<ItemFlag, Set<DataComponentType<?>>> ITEM_FLAG_EQUIVALENTS = ImmutableMap.<ItemFlag, Set<DataComponentType<?>>>builder()
         .put(ItemFlag.HIDE_ATTRIBUTES, Set.of(DataComponents.ATTRIBUTE_MODIFIERS))
