-            tag.put(CraftMetaItem.TOOLTIP_DISPLAY, new TooltipDisplay(this.tooltipDisplay.hideTooltip(), new ReferenceLinkedOpenHashSet<>(this.tooltipDisplay.hiddenComponents())));
+            tag.put(CraftMetaItem.TOOLTIP_DISPLAY, new TooltipDisplay(this.tooltipDisplay.hideTooltip(), new dev.lynxplay.ktp.item.component.DataComponentSequencedSet(this.tooltipDisplay.hiddenComponents())));  // KTP - order tooltip display hiddenComponents
