From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bjarne Koll <git@lynxplay.dev>
Date: Sun, 22 Mar 2026 16:09:49 +0000
Subject: [PATCH] Order TooltipDisplay hiddenComponents

The usage of ReferenceLinkedOpenHashSet is rather questionable as it
maintains a specific iteration order while completely ignoring it for
comparison purposes.
As such, it breaks any form of consistent serialisation of itemstacks as
the encoder cache considers two ReferenceLinkedOpenHashSet instances
with different iteration orders equal even if they would not produce an
equal nbt output.

Replace it with the RegistrySinkSortedSet, which uses the registry id of
each data component to enforce order.

diff --git a/src/main/java/dev/lynxplay/ktp/item/component/DataComponentSequencedSet.java b/src/main/java/dev/lynxplay/ktp/item/component/DataComponentSequencedSet.java
new file mode 100644
index 0000000000000000000000000000000000000000..c91cb72a4a0e4b3a68ae2b78017621e0f52bb8ff
--- /dev/null
+++ b/src/main/java/dev/lynxplay/ktp/item/component/DataComponentSequencedSet.java
@@ -0,0 +1,19 @@
+package dev.lynxplay.ktp.item.component;
+
+import dev.lynxplay.ktp.core.RegistrySinkSequencedSet;
+import net.minecraft.core.component.DataComponentType;
+import net.minecraft.core.registries.BuiltInRegistries;
+
+import java.util.Collection;
+
+public class DataComponentSequencedSet extends RegistrySinkSequencedSet<DataComponentType<?>> {
+
+    public DataComponentSequencedSet() {
+        super(BuiltInRegistries.DATA_COMPONENT_TYPE);
+    }
+
+    public DataComponentSequencedSet(final Collection<? extends DataComponentType<?>> other) {
+        super(BuiltInRegistries.DATA_COMPONENT_TYPE, other);
+    }
+
+}
