From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bjarne Koll <git@lynxplay.dev>
Date: Thu, 26 Feb 2026 10:25:56 +0000
Subject: [PATCH] Expose original player profile

When changing a player profile after the player connected, certain
plugins might be interested in their original, mojang authenticated,
usernames.
Expose the original player profile for this usecase.

diff --git a/src/main/java/org/bukkit/entity/Player.java b/src/main/java/org/bukkit/entity/Player.java
index 8978fe663e1077f31c21f07486696e72b043ac39..c635f2d66050516c7f2dbac6c65eeb28e5ba9c4f 100644
--- a/src/main/java/org/bukkit/entity/Player.java
+++ b/src/main/java/org/bukkit/entity/Player.java
@@ -4122,4 +4122,10 @@ public interface Player extends HumanEntity, Conversable, OfflinePlayer, PluginM
 0     */
     net.kyori.adventure.util.TriState glowOverride(Entity entity);
     // KTP end - glow override
+    // KTP start - expose original game profile
+    /**
+     * {@return the player profile this player originally logged in with.}
+     */
+    com.destroystokyo.paper.profile.PlayerProfile getOriginalPlayerProfile();
+    // KTP end - expose original game profile
 }
